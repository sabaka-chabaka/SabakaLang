<Project>
    <PropertyGroup>
        <SabakaTfm Condition="'$(SabakaTfm)' == ''">net11.0</SabakaTfm>
        <TargetFramework>$(SabakaTfm)</TargetFramework>
        <LangVersion>preview</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    </PropertyGroup>
    <PropertyGroup Condition="'$(SabakaTfm)' == 'net11.0'">
        <DefineConstants>$(DefineConstants);SABAKA_CS15</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
        <PublishDir>$(MSBuildThisFileDirectory)publish\</PublishDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
        <IsPublishable>false</IsPublishable>
    </PropertyGroup>
</Project>
